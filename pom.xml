<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pengcheng.phoenixgraph</groupId>
    <artifactId>phoenixgraph</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PhoenixGraph</name>
    <description>A High Scaled and High Performance HTAP Graph Database</description>

    <modules>
        <module>graph-core</module>
        <module>graph-schema</module>
        <module>graph-storage</module>
        <module>graph-storage-aerospike</module>
        <module>graph-storage-rocksdb</module>
        <module>graph-storage-rocksdb-inline</module>
        <module>graph-storage-rocksdb-edge</module>
        <module>graph-query</module>
        <module>graph-query-aerospike</module>
        <module>graph-query-gremlin</module>
        <module>graph-hnsw</module>
        <module>graph-query-cypher</module>
        <module>graph-compute-engine</module>
        <module>graph-web</module>
        <module>graph-http</module>
        <module>graph-batch-load</module>
        <module>graph-mapreduce</module>
        <module>graph-integration-test</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>

        <spring-boot.version>3.5.16</spring-boot.version>
        <junit.version>5.11.4</junit.version>
        <jackson.version>2.19.4</jackson.version>
        <aerospike.version>8.0.0</aerospike.version>
        <rocksdb.version>9.11.2</rocksdb.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-schema</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-storage-aerospike</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-storage-rocksdb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-storage-rocksdb-inline</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-storage-rocksdb-edge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-query</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-query-aerospike</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-query-gremlin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-hnsw</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-query-cypher</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-compute-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-batch-load</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-mapreduce</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pengcheng.phoenixgraph</groupId>
                <artifactId>graph-integration-test</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Boot BOM (used by graph-web) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- JUnit 5 BOM -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Aerospike client -->
            <dependency>
                <groupId>com.aerospike</groupId>
                <artifactId>aerospike-client</artifactId>
                <version>${aerospike.version}</version>
            </dependency>
            <dependency>
                <groupId>org.rocksdb</groupId>
                <artifactId>rocksdbjni</artifactId>
                <version>${rocksdb.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!-- keep method parameter names in the bytecode: Spring resolves
                             @PathVariable / @RequestParam by name, and without this a
                             handler taking "@PathVariable Object id" cannot be bound -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
