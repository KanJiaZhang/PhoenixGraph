{
  "name": "@phoenixgraph/client",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript client for the PhoenixGraph HTTP API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": ["graph", "knowledge-graph", "retrieval", "provenance", "phoenixgraph"],
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
