sg:朱淑媛 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Female ;
    <http://www.w3.org/2000/01/rdf-schema#label> "朱淑媛"@zh ;
    sg:courtesyName "朱淑媛"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "魏文帝曹丕夫人。生东武阳怀王曹鉴。"@zh ;
    sg:wife sg:曹丕 ;
    sg:serves sg:魏 .
sg:鲁昭公 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "鲁昭公"@zh ;
    sg:courtesyName "魯昭公"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "鲁国之二十六代君主。前542年即位，前517年，鲁昭公伐季孙氏，但大败，鲁昭公逃到齐国，前510年，昭公死。"@zh ;
    sg:novelDescription "春秋时期人，演义中曾提到此人。"@zh ;
    sg:serves sg:其他 ;
    sg:appearsIn sg:第114回 .
sg:和逌 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "和逌"@zh ;
    sg:courtesyName "和逌"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "和洽子。正元中为侍中。官至廷尉、吏部尚书。"@zh ;
    sg:father sg:和郁 ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:豫州汝南郡西平 ;
    sg:father sg:和峤 .
sg:羊角哀 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "羊角哀"@zh ;
    sg:courtesyName "羊角哀"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "春秋时燕人，与左伯桃为友，一同到楚国去谋事，路途中干粮用尽，又降大雪，左伯桃认为学问不如羊角哀，便脱衣冻死，让羊角哀把自己的衣服穿上，把剩余的干粮带走。羊角哀到了楚国，楚平王因爱惜羊角哀的才能，以上卿的礼节安葬左伯桃。其后羊角哀梦见左..."@zh ;
    sg:novelDescription "春秋时燕人，与左伯桃为友，有羊角哀舍命全交的典故。三国演义中有提及此人。"@zh ;
    sg:serves sg:其他 ;
    sg:nativePlace sg:雍州 ;
    sg:appearsIn sg:第26回 .
sg:曹玹 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "曹玹"@zh ;
    sg:courtesyName "曹玹"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "曹操之子。建安十六年（211），封西乡侯。早卒。魏太和四年（230），追进玹爵，谥曰怀公。六年，又进号曰怀王。"@zh ;
    sg:brother sg:曹上 ;
    sg:son sg:曹操 ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:豫州沛国谯 .
sg:典韦 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "典韦"@zh ;
    sg:courtesyName "典韋"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "武猛校尉。擅使大双戟，膂力过人。为人壮猛任侠，曾为乡人刘氏报雠，杀人出市，追者数百人也莫敢近，由是为豪杰所识。初属张邈，属司马赵宠。军中的牙门旗既长且大，人们都不能把它举起，而典韦竟以一手便将其执而竖起。后属夏侯惇，曹操讨吕布于濮阳时..."@zh ;
    sg:novelDescription "擅使大双戟，为人壮猛任侠，曾为友人报雠，杀人出市，人莫敢近。初属张邈，后与人不和，杀人外逃，因逐虎过涧而被射猎中的夏侯惇所见，异其悍武，引至军中荐与太祖。其时帐前牙门旗既长且大，风吹欲倒，军人莫能持定，而韦竟以一手稳之，众皆以奇力为异..."@zh ;
    sg:serves sg:魏 ;
    sg:holds sg:武猛校尉 ;
    sg:nativePlace sg:兖州陈留郡己吾 ;
    sg:appearsIn sg:第10回 ;
    sg:appearsIn sg:第11回 ;
    sg:appearsIn sg:第12回 ;
    sg:appearsIn sg:第14回 ;
    sg:appearsIn sg:第16回 ;
    sg:appearsIn sg:第17回 ;
    sg:appearsIn sg:第18回 ;
    sg:appearsIn sg:第58回 ;
    sg:minister sg:曹操 .
sg:曹盱 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "曹盱"@zh ;
    sg:courtesyName "曹盱"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "据《会稽典录》记载，曹娥的父亲曹盱，能抚节按歌，婆娑乐神。相传在东汉汉安二年(公元143的)五月五日，曹盱为迎伍君，在江上逆涛而上，不幸失足坠江而死。他的女儿曹娥时年14，沿江日夜哀号，哭声不绝，后亦投江而死。过了几天，她身背父尸，浮..."@zh ;
    sg:novelDescription "昔和帝时，上虞有一巫者，名曹盱，能婆娑乐神。五月五日，醉舞舟中，堕江而死。其女年十四岁，绕江啼哭七昼夜，跳入波中。后五日，负父之尸，浮于江面。里人葬之江边。"@zh ;
    sg:serves sg:在野 ;
    sg:nativePlace sg:扬州会稽郡上虞 ;
    sg:appearsIn sg:第71回 .
sg:朱琬 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "朱琬"@zh ;
    sg:courtesyName "朱琬"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "父朱才卒，袭爵为将，至镇西将军。凤皇元年（272），从都督陆抗击叛将步阐，拒晋援军巴东监军徐胤于建平。"@zh ;
    sg:serves sg:吴 ;
    sg:nativePlace sg:扬州丹阳郡故鄣 .
sg:綦毌闿 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "綦毌闿"@zh ;
    sg:courtesyName "綦毌闓"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "经学家。刘表立学官，博求儒士，使其与宋忠等撰《五经章句》，称之《后定》。"@zh ;
    sg:serves sg:东汉 .
sg:仲兴 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "仲兴"@zh ;
    sg:courtesyName "仲興"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "曹节次子，曹腾兄。"@zh ;
    sg:serves sg:东汉 ;
    sg:nativePlace sg:豫州沛国谯 .
sg:楚义帝 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "楚义帝"@zh ;
    sg:courtesyName "楚義帝"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "战国时楚怀王熊槐之孙，楚亡后，隐匿民间为人牧羊。项梁起事，采纳范增的建议，自称武信君并立熊心为楚怀王，以从民望。项梁在定陶败死，怀王以宋义为上将军，项羽为次将，率兵救赵。又令刘邦西向略地入关。与诸将约，先入关中者王之。项羽杀宋义，在钜..."@zh ;
    sg:novelDescription "后楚怀王，名熊心，是战国末期楚怀王熊槐的孙子。秦二世二年（前208年）夏六月，被楚地反秦义军首领项梁等拥立为王，仍号“楚怀王”。三国演义中有提及此人。"@zh ;
    sg:serves sg:其他 ;
    sg:appearsIn sg:第14回 .
sg:万秉 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "万秉"@zh ;
    sg:courtesyName "萬秉"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "东汉末黄巾起义首领。秉坚持斗争，直到建安年间才被孙权部朱治率兵平息。"@zh ;
    sg:serves sg:起义军 .
sg:鲜于银 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "鲜于银"@zh ;
    sg:courtesyName "鮮于銀"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "事刘虞为骑都尉。公孙瓒败虞，获之，胁段训杀虞。银等举州兵欲为虞报仇，共推阎柔为乌丸司马，迎虞子和，与袁绍将曲义合兵共击瓒，瓒败。"@zh ;
    sg:serves sg:东汉 .
sg:广阳顺王 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "广阳顺王"@zh ;
    sg:courtesyName "廣陽順王"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "应为“广阳顷王”，汉皇族。三国时魏官吏刘放远祖。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:幽州涿郡 .
sg:东里衮 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "东里衮"@zh ;
    sg:courtesyName "東裏衮"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "任南阳太守。建安二十四年（219），宛守将侯音等反，囚衮。后被释。"@zh ;
    sg:serves sg:魏 .
sg:葛雍 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "葛雍"@zh ;
    sg:courtesyName "葛雍"@zh ;
    sg:historicity "虚构人物"@zh ;
    sg:historicalDescription "虚构人物，出自三国演义。"@zh ;
    sg:novelDescription "毌丘俭先锋。俭反，司马师兴兵讨之。俭先锋葛雍曰：“南顿之地，依山傍水，极好屯兵；若魏兵先占，难以驱遣，可速取之。”俭然之。待到南顿时，司马师部将王基已先在此下寨。后在项城与邓艾战，被艾斩。"@zh ;
    sg:serves sg:魏 ;
    sg:appearsIn sg:第110回 .
sg:荀靖 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "荀靖"@zh ;
    sg:courtesyName "叔慈"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "隐士。荀彧叔父。少有俊才，隐居终身不仕。号玄行先生。"@zh ;
    sg:serves sg:在野 ;
    sg:nativePlace sg:豫州颍川郡颍阴 .
sg:陈琮 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "陈琮"@zh ;
    sg:courtesyName "公琰"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "汉末汝阴太守，其兄陈瑀与袁术交恶，公琰请和于术，为术所执。"@zh ;
    sg:serves sg:东汉 ;
    sg:nativePlace sg:徐州下邳国淮浦 .
sg:徐庶 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "徐庶"@zh ;
    sg:courtesyName "元直"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "年少时爱好任侠击剑，后折节向学，因中原战乱，客居于荆州，与诸葛亮、司马徽、庞统等人相友善。后徐庶效力于刘备，还推荐了诸葛亮。长坂之战时，徐庶的母亲被曹军抓获，于是徐庶北投曹操，在魏官至右中郎将、御史中丞。"@zh ;
    sg:novelDescription "演义中又为单福。年少时爱好击剑，后折节向学，游学四方。刘备在新野时，徐庶化名单福，投效与刘备，被拜为军师。徐庶为刘备出谋划策，击败曹将吕旷、吕翔，斗阵胜曹仁，并计取樊城。不久曹操手下谋士程昱识破了徐庶的身份，称徐庶之才十倍于己。曹操欲..."@zh ;
    sg:serves sg:蜀 ;
    sg:serves sg:魏 ;
    sg:holds sg:右中郎将 ;
    sg:holds sg:御史中丞 ;
    sg:nativePlace sg:豫州颍川郡 ;
    sg:appearsIn sg:第35回 ;
    sg:appearsIn sg:第36回 ;
    sg:appearsIn sg:第37回 ;
    sg:appearsIn sg:第38回 ;
    sg:appearsIn sg:第39回 ;
    sg:appearsIn sg:第41回 ;
    sg:appearsIn sg:第47回 ;
    sg:appearsIn sg:第48回 ;
    sg:minister sg:刘备 ;
    sg:minister sg:曹操 .
sg:郑小同 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "郑小同"@zh ;
    sg:courtesyName "子真"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "著名学者郑玄孙。学综六经，初为郎中，累迁至侍中，封关内侯，高贵乡公甘露三年（258），拜为五更。后为大将军司马昭鸩杀。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:青州北海国高密 .
sg:陈堪 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "陈堪"@zh ;
    sg:courtesyName "陳堪"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "西晋官吏，陈准从弟。时有张子并、陈梁甫能书。甫恨逋，并恨峻，象斟酌其间，甚得其妙，中国善书者不能及也。"@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:豫州颍川郡许 .
sg:桓氏 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "桓氏"@zh ;
    sg:courtesyName "桓氏"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "对本郡严干、李义很赏识，认为他们各有器实。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:司隶冯翊 .
sg:灵怀皇后 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Female ;
    <http://www.w3.org/2000/01/rdf-schema#label> "灵怀皇后"@zh ;
    sg:courtesyName "靈懷皇后"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "即王美人，生汉献帝。祖父王苞为五官中郎将。王美人姿色秀丽，聪敏有才明，能书会计，以良家子的身份选入掖庭。当时灵帝的皇后何氏“性强忌，后宫莫不震慑”。王美人怀孕后，畏惧何皇后，服药欲堕胎，而胎安不动，又数次梦到负日而行。光和四年（公元1..."@zh ;
    sg:novelDescription "即王美人，生汉献帝。帝宠幸王美人，生皇子协。何后嫉妒，鸩杀王美人。"@zh ;
    sg:wife sg:刘宏 ;
    sg:serves sg:东汉 ;
    sg:nativePlace sg:冀州赵国邯郸 ;
    sg:appearsIn sg:第2回 .
sg:何仪 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "何仪"@zh ;
    sg:courtesyName "何儀"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "汝南、颍川处的黄巾军将领，聚众数万，先是响应袁术，后又依附孙坚，最终被曹操击败，率众投降。"@zh ;
    sg:novelDescription "黄巾军余党，被曹操率兵击败，逃跑途中为聚众自守的许褚所擒。后许褚归顺曹操，献出何仪，何仪即被处斩。"@zh ;
    sg:serves sg:魏 ;
    sg:serves sg:张角势力 ;
    sg:appearsIn sg:第12回 .
sg:庞延 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "庞延"@zh ;
    sg:courtesyName "龐延"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "为张既所礼辟，终有名位。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:司隶扶风 .
sg:梁广 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "梁广"@zh ;
    sg:courtesyName "梁廣"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "孙亮时，曾与韦曜、周昭、薛莹、华覈等共撰吴国史。"@zh ;
    sg:serves sg:吴 .
sg:史璜 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "史璜"@zh ;
    sg:courtesyName "史璜"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "朱符死后，汉遣张津为交州刺史，津后又为其将区景所杀，而荆州牧刘表遣零陵赖恭代津。是时苍梧太守史璜死，表又遣吴巨代之，与恭俱至。"@zh ;
    sg:serves sg:东汉 .
sg:阴贵人 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Female ;
    <http://www.w3.org/2000/01/rdf-schema#label> "阴贵人"@zh ;
    sg:courtesyName "陰貴人"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "魏文帝曹丕夫人。黄初初年，与郭贵嫔等并为文帝所爱幸，致使元妃甄氏有怨言而被赐死。"@zh ;
    sg:wife sg:曹丕 ;
    sg:serves sg:魏 .
sg:和峤 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "和峤"@zh ;
    sg:courtesyName "长舆"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "和逌子。盛名于世。魏末为颍川太守，有政绩。晋武帝时任给事黄门侍郎、中书令，常与帝共车入朝。惠帝时拜太子少傅，加散骑常侍、光禄大夫。死后追谥简，家产富于王者，人以为有钱癖。"@zh ;
    sg:brother sg:和郁 ;
    sg:son sg:和逌 ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:豫州汝南郡西平 .
sg:轲比能 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "轲比能"@zh ;
    sg:courtesyName "軻比能"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "汉末三国时期的鲜卑民族的杰出首领，由于他作战勇敢，执法公平，不贪财物，所以被鲜卑民众推举为大人。他的部落近塞，所以他抓住有利条件积极学习汉族先进技术和文化，促进了鲜卑族的进步和北方的民族融合。他统率下的部众，战守有法，战斗力相当强大。..."@zh ;
    sg:novelDescription "鮮卑王。呼應曹丕五路進攻蜀漢的計劃，與羌兵一同出征。知道對手是令異族聞風喪膽的“神威將軍”馬超後，便不戰而自行逃回。"@zh ;
    sg:serves sg:少数民族 ;
    sg:holds <http://pengcheng.com/phoenixgraph/kg/sanguo#鲜卑首领%20%20附义王> ;
    sg:appearsIn sg:第85回 .
sg:云午 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "云午"@zh ;
    sg:courtesyName "雲午"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "三国时魏优人。"@zh ;
    sg:serves sg:魏 .
sg:王恂 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "王恂"@zh ;
    sg:courtesyName "良夫"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "父肃，魏侍中，太常。肃死，魏元帝景元四年（263），封恂兰陵侯，咸熙中，改封氶子。恂为晋武帝母舅，历官河南尹、侍中。武帝咸宁四年（278）卒，年四十余。赠车骑将军。"@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:徐州东海郡郯 .
sg:灌均 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "灌均"@zh ;
    sg:courtesyName "灌均"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "为监国谒者。黄初二年（221），均奏曹植过，曹丕贬植为安乡侯。"@zh ;
    sg:serves sg:魏 .
sg:李休 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "李休"@zh ;
    sg:courtesyName "子郎"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "居南郑，为镇北将军张鲁的司马。张鲁败，曹操因休曾劝张鲁投降，赐爵关内侯，署散官骑从。黄初中，历上党、钜鹿太守，后以年老还，拜议郎。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:荆州南阳郡 .
<http://pengcheng.com/phoenixgraph/kg/sanguo#李邵（蜀）> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "李邵（蜀）"@zh ;
    sg:courtesyName "永南"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "刘备据蜀后，任州书佐部从事。建兴元年（223），诸葛亮辟为丞相府西曹掾。诸葛亮南征，留守为治中从事，是年卒。"@zh ;
    sg:serves sg:蜀 ;
    sg:nativePlace sg:益州广汉郡郪 .
sg:袁敞 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "袁敞"@zh ;
    sg:courtesyName "叔平"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "袁安之子。少传《易经》，因父任为太子舍人。和帝时任东郡太守，征拜太仆光禄勋，迁司空。敞廉洁刚毅，不阿权贵。因失外戚邓氏旨而自杀。"@zh ;
    sg:serves sg:东汉 ;
    sg:nativePlace sg:豫州汝南郡汝阳 .
sg:郑舒 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "郑舒"@zh ;
    sg:courtesyName "鄭舒"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "郑袤第三子。位至列卿。"@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:司隶河南尹开封 .
sg:黄忠 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "黄忠"@zh ;
    sg:courtesyName "汉升"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "初为刘表帐下中郎将，与刘表侄子刘磐共守长沙攸县。刘琮降曹后为曹操任为代理裨将军，统属于长沙太守韩玄，刘备平荊南四郡后改为刘备属下。跟随刘备入蜀，作战时常先登陷陈，勇毅冠三军。益州平后拜为讨虏将军。汉中之战时，黄忠军于定军山斩夏侯渊，迁..."@zh ;
    sg:novelDescription "初为刘表帐下中郎将，与表侄刘磐共守长沙，后事韩玄；虽年近六旬，却有万夫不当之勇。先主使关羽攻长沙，忠与羽连战三日，不分胜负。忠感动羽义气，不忍以弓箭相伤。玄以忠战羽不利欲斩之，为魏延所救，降刘备。黄忠随刘备入蜀，战功赫赫。先与严颜败张..."@zh ;
    sg:holds sg:五虎上将 ;
    sg:serves sg:刘表势力 ;
    sg:serves sg:蜀 ;
    sg:serves sg:魏 ;
    sg:holds sg:后将军 ;
    sg:holds sg:关内侯 ;
    sg:nativePlace sg:荆州南阳郡 ;
    sg:appearsIn sg:第53回 ;
    sg:appearsIn sg:第55回 ;
    sg:appearsIn sg:第56回 ;
    sg:appearsIn sg:第60回 ;
    sg:appearsIn sg:第62回 ;
    sg:appearsIn sg:第63回 ;
    sg:appearsIn sg:第64回 ;
    sg:appearsIn sg:第65回 ;
    sg:appearsIn sg:第70回 ;
    sg:appearsIn sg:第71回 ;
    sg:appearsIn sg:第72回 ;
    sg:appearsIn sg:第73回 ;
    sg:appearsIn sg:第77回 ;
    sg:appearsIn sg:第81回 ;
    sg:appearsIn sg:第82回 ;
    sg:appearsIn sg:第83回 ;
    sg:appearsIn sg:第91回 ;
    sg:minister sg:刘备 .
sg:袁徽 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "袁徽"@zh ;
    sg:courtesyName "曜仁"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "隐士。以儒素称。时天下大乱，避难交州。司徒辟，不就。"@zh ;
    sg:serves sg:在野 ;
    sg:nativePlace sg:豫州陈国扶乐 .
sg:薛乔 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "薛乔"@zh ;
    sg:courtesyName "薛喬"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "任越骑校尉。曹休丧母，乔奉诏劝休节哀。"@zh ;
    sg:novelDescription "却说陆逊唤朱桓、全琮分付曰：“汝二人各引三万军，从石亭山路抄到曹休寨后，放火为号。吾亲率大军从中路而进，可擒曹休也。”当日黄昏，二将受计，引兵而进。二更时分，朱桓引一军正抄到魏寨后，迎着张普伏兵。普不知是吴兵，径来问时，被朱桓一刀斩于..."@zh ;
    sg:serves sg:魏 ;
    sg:appearsIn sg:第96回 .
sg:殷礼 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "殷礼"@zh ;
    sg:courtesyName "德嗣"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "精通占天卜候之术。由吴县丞升郎中。曾出使蜀国，深受诸葛亮赏识。任尚书户曹郎，迁零陵太守卒。"@zh ;
    sg:serves sg:吴 ;
    sg:nativePlace sg:司隶冯翊云阳 .
sg:苴罗侯 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "苴罗侯"@zh ;
    sg:courtesyName "苴羅侯"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "三国时人。鲜卑族首领轲比能弟。后为曹魏军队所杀。"@zh ;
    sg:serves sg:少数民族 .
sg:胡喜 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "胡喜"@zh ;
    sg:courtesyName "林甫"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "以开济为称，官至凉州刺史、建武将军、假节、护羌校尉。"@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:凉州安定郡临泾 .
sg:应劭 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "应劭"@zh ;
    sg:courtesyName "仲瑗"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "少笃学，博览多闻。灵帝时举孝廉。中平六年（189），拜泰山太守。献帝兴平元年（194），曹操父、弟在其辖境内被杀，劭惧操报复，弃官投奔袁绍。任军谋校尉。后卒于邺。劭著有《汉官礼仪故事》、《状人纪》、《中汉辑序》、《风俗通》、《汉书集解..."@zh ;
    sg:novelDescription "自是，曹操部下，文有谋臣，武有猛将，威镇山东。乃遣泰山太守应劭往瑯琊郡取父曹嵩。"@zh ;
    sg:serves sg:袁绍势力 ;
    sg:nativePlace sg:豫州汝南郡南顿 ;
    sg:appearsIn sg:第10回 .
sg:毛嘉 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "毛嘉"@zh ;
    sg:courtesyName "毛嘉"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "三国时魏明帝皇后毛氏之父。太和元年（227）拜骑都尉。后封博平乡侯，迁光禄大夫。青龙三年（235）卒，改封安国侯，谥曰节侯。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:司隶河内郡 .
sg:苏固 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "苏固"@zh ;
    sg:courtesyName "蘇固"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "益州牧刘焉以鲁为督义司马，与别部司马张脩将兵击汉中太守苏固，鲁遂袭脩杀之，夺其众。"@zh ;
    sg:serves sg:东汉 .
sg:刘乔 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "刘乔"@zh ;
    sg:courtesyName "仲彦"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "少为秘书郎，参与伐吴之役以及诛杨骏、除贾谧之谋，因功累迁至散骑常侍，封关中侯、安众男。八王之乱初期，为威远将军、豫州刺史，率兵讨张昌，进为左将军。后东海王司马越当权，乔举兵抗命，附河间王司马颙，不久，兵败。司马越去世后，复为都督豫州诸..."@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:荆州南阳郡 .
sg:孔尚 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "孔尚"@zh ;
    sg:courtesyName "孔尚"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "东汉末著名学者孔融高祖父。官钜鹿太守。"@zh ;
    sg:serves sg:东汉 ;
    sg:nativePlace sg:豫州鲁国郡 .
sg:程昱 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "程昱"@zh ;
    sg:courtesyName "仲德"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "因梦中於泰山捧日，更名为昱。黄巾起，县丞王度反应之，烧仓库。昱使人侦视度，度等得空城不能守，出城西五六里止屯。昱同县中大姓薛房击之，度等破走。东阿由此得全。初平中，兖州刺史刘岱辟昱，昱不应。时岱与袁绍、公孙瓒和亲，后绍、瓒相攻，瓒胜，..."@zh ;
    sg:novelDescription "初在山中读书，经荀彧荐仕曹操。曾于徐州用计迫降关羽；曹操征河北，昱举羽以敌颜良，又於仓亭献十面埋伏之计，大胜袁绍。后与刘备战，昱计挟亲赚徐庶，使庶来投。从南征，昱谏曹操以防火攻，又识黄盖粮船之伪，免大寨遭创，曹操亦因此逃逸得及。后又于..."@zh ;
    sg:serves sg:魏 ;
    sg:holds sg:卫尉 ;
    sg:holds sg:安乡侯 ;
    sg:holds sg:追赠车骑将军 ;
    sg:nativePlace sg:兖州东郡东阿 ;
    sg:appearsIn sg:第10回 ;
    sg:appearsIn sg:第11回 ;
    sg:appearsIn sg:第12回 ;
