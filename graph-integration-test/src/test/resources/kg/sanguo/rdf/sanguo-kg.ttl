sg:貂蝉 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Female ;
    <http://www.w3.org/2000/01/rdf-schema#label> "貂蝉"@zh ;
    sg:courtesyName "貂蟬"@zh ;
    sg:historicity "虚构人物"@zh ;
    sg:historicalDescription "虚构人物，出自民间传说。"@zh ;
    sg:novelDescription "舍身报国的可敬女子，她为了挽救天下黎民，为了推翻权臣董卓的荒淫统治，受王允所托，上演了可歌可泣的连环计（连环美人计），周旋于两个男人之间，成功的离间了董卓和吕布，最终吕布将董卓杀死，结束了董卓专权的黑暗时期。"@zh ;
    sg:adopted_daughter sg:王允 ;
    sg:concubine sg:吕布 ;
    sg:wife sg:吕布 ;
    sg:serves sg:东汉 ;
    sg:serves sg:董卓势力 ;
    sg:appearsIn sg:第8回 ;
    sg:appearsIn sg:第9回 ;
    sg:appearsIn sg:第11回 ;
    sg:appearsIn sg:第13回 ;
    sg:appearsIn sg:第16回 ;
    sg:appearsIn sg:第19回 ;
    sg:appearsIn sg:第20回 .
sg:王廙 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "王廙"@zh ;
    sg:courtesyName "王廙"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "是岁基薨，追赠司空，谥曰景侯。子徽嗣，早卒。咸熙中，开建五等，以基著勋前朝，改封基孙廙，而以东武余邑赐一子爵关内侯。"@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:青州东莱郡曲成 .
sg:袁礼 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "袁礼"@zh ;
    sg:courtesyName "袁禮"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "任中书郎。初孙权信任酷吏吕壹，后吕壹奸露伏诛，权乃使礼告谢诸大将，引咎自责。"@zh ;
    sg:serves sg:吴 .
sg:孟武 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "孟武"@zh ;
    sg:courtesyName "孟武"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "魏曹丕文德郭皇后姊子。曾还乡里，求小妻，为后劝止。"@zh ;
    sg:serves sg:魏 .
sg:崔瑷 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "崔瑷"@zh ;
    sg:courtesyName "子玉"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "文学家、书法家。崔骃之子。早孤，锐志好学。年十八，至京师，从侍中贾逵质正大义，遂精通天文、历数、《京房易传》等。因为兄报仇，杀人而逃至他方，会赦，归家。年四十余，始为郡吏。后几为贵戚吏，皆不遇被斥。举茂才，迁汲令。在事数言便宜，为人开..."@zh ;
    sg:serves sg:东汉 ;
    sg:nativePlace sg:冀州安平国安平 .
sg:夏侯氏 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Female ;
    <http://www.w3.org/2000/01/rdf-schema#label> "夏侯氏"@zh ;
    sg:courtesyName "夏侯氏"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "单固之母。曾劝其子跟从兖州刺史令狐愚为幕僚。后因单固参与令狐愚谋反而遭刑戮。临死愧不敢仰视其母。夏侯氏则以为其过在己。"@zh ;
    sg:wife sg:单伯龙 ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:兖州山阳郡 ;
    sg:wife sg:张飞 .
sg:王遂 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "王遂"@zh ;
    sg:courtesyName "王遂"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "嘉禾中铸大钱，曾私取，后为典军吏刘助所觉。"@zh ;
    sg:serves sg:吴 .
sg:游殷 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "游殷"@zh ;
    sg:courtesyName "游殷"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "为郡功曹。托子楚于小吏张既，后楚果得既助而显名，故关中称殷“生有知人之明”。"@zh ;
    sg:serves sg:东汉 ;
    sg:nativePlace sg:司隶冯翊 .
sg:沈珩 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "沈珩"@zh ;
    sg:courtesyName "仲山"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "少综贯经艺，尤善《春秋》内外传。初任西曹掾，孙权以为有智谋，能专对，乃使至魏，随事应答魏文帝，无所屈服。以奉使敏达而获得声誉，封永安乡侯，官至少府。"@zh ;
    sg:serves sg:吴 ;
    sg:nativePlace sg:扬州吴郡 .
sg:王隆 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "王隆"@zh ;
    sg:courtesyName "王隆"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "平东将军、尚书王虔之子。"@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:徐州东海郡郯 .
sg:钟会 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "钟会"@zh ;
    sg:courtesyName "士季"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "自幼才华横溢，上至皇帝、下至群臣都对他非常赏识。在征讨毌丘俭、诸葛诞其间，钟会屡出奇谋。被人比作西汉谋士张良，又曾为司马昭献策阻止了曹髦的夺权企图，钟会得以成为司马氏的亲信。景元年间，钟会独力支持司马昭的伐蜀计划，从而发动伐蜀之战。灭..."@zh ;
    sg:novelDescription "少有异才，受众人赏识，夏侯霸降蜀后预言其终究成为吴蜀之大患。毌丘俭叛乱后，钟会说服司马师亲征。司马师病死后，钟会又帮助司马昭保住兵权。诸葛诞叛乱其间，钟会多次献策助司马昭平叛。又画西蜀图本力劝司马昭伐蜀。伐蜀其间，钟会为严军法，处死名..."@zh ;
    sg:serves sg:魏 ;
    sg:holds sg:司徒 ;
    sg:holds sg:假节 ;
    sg:holds sg:都督关中诸军事 ;
    sg:holds sg:县侯 ;
    sg:nativePlace sg:豫州颍川郡长社 ;
    sg:appearsIn sg:第107回 ;
    sg:appearsIn sg:第110回 ;
    sg:appearsIn sg:第112回 ;
    sg:appearsIn sg:第115回 ;
    sg:appearsIn sg:第116回 ;
    sg:appearsIn sg:第117回 ;
    sg:appearsIn sg:第118回 ;
    sg:appearsIn sg:第119回 ;
    sg:appearsIn sg:第120回 ;
    sg:son sg:钟繇 ;
    sg:minister sg:曹操 .
sg:张世平 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "张世平"@zh ;
    sg:courtesyName "張世平"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "商人。世平、苏双等赀累千金，贩马周旋于涿郡，见刘备而异之，乃多与之金财。备由是得用合徒众。"@zh ;
    sg:novelDescription "刘备、关羽、张飞三人结拜毕，来日收拾军器，但恨无马匹可乘。正思虑间，人报有两个客人，引一伙伴当，赶一群马，投庄上来。三人出庄迎接。乃世平同苏双，每年往北贩马，近因寇发而回。备请二人到庄，置酒管待，诉说欲讨贼安民之意。二客大喜，愿将良马..."@zh ;
    sg:serves sg:在野 ;
    sg:holds sg:无 ;
    sg:nativePlace sg:冀州中山国 ;
    sg:appearsIn sg:第1回 .
sg:乐资 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "乐资"@zh ;
    sg:courtesyName "樂資"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "撰《山阳公载记》等书，为南朝宋裴松之注《三国志》所引，今已佚。"@zh ;
    sg:serves sg:西晋 .
sg:赵达 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "赵达"@zh ;
    sg:courtesyName "趙達"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "三国时魏官吏。任校事。执法多以爱憎。后奸事发，被曹操处死。"@zh ;
    sg:serves sg:魏 ;
    sg:holds sg:校事 .
sg:赵温 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "赵温"@zh ;
    sg:courtesyName "子柔"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "初为京兆郡丞，弃官去。献帝西迁，累拜司徒，录尚书市，封江南亭侯。李傕劫献帝至北坞，纳温于坞中，傕又欲移献帝于黄白城，温移书责傕，几乎被杀。"@zh ;
    sg:serves sg:东汉 ;
    sg:nativePlace <http://pengcheng.com/phoenixgraph/kg/sanguo#益州蜀郡成都[蜀郡]> .
sg:陈桃 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "陈桃"@zh ;
    sg:courtesyName "陳桃"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "又臣郡吏陈桃梦臣与道士相遇，放发被鹿裘，布易六爻，挠其三以饮臣，臣乞尽吞之。"@zh ;
    sg:serves sg:东汉 .
sg:陈祎 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "陈祎"@zh ;
    sg:courtesyName "陳禕"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "建安二十四年（219），为长乐卫尉。时曹操出兵在外，魏讽与祎谋袭邺都，未及期，祎惧而告发。"@zh ;
    sg:serves sg:魏 .
sg:李兴 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "李兴"@zh ;
    sg:courtesyName "雋石"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "历任别驾、参军、太傅掾。惠帝永兴中，镇南将军刘弘命他撰诸葛亮、羊祜碣文。"@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:益州犍为郡武阳 .
sg:徐顾 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "徐顾"@zh ;
    sg:courtesyName "徐顧"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "其所驻屯之地与吕蒙营相比邻。顾死，吴主孙权欲以其众并入吕蒙军中，吕蒙坚辞不受，认为顾为国辛劳，他死后应该让其子弟为将。"@zh ;
    sg:serves sg:吴 .
sg:沮宗 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "沮宗"@zh ;
    sg:courtesyName "沮宗"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "沮授弟。官渡之战前夕，授知绍必败而散其资产，宗却认为曹操兵马不敌绍。"@zh ;
    sg:serves sg:袁绍势力 ;
    sg:nativePlace sg:冀州巨鹿郡广平 .
sg:关羽 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "关羽"@zh ;
    sg:courtesyName "云长"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "前将军。本字长生，亡命奔涿郡。与张飞追随刘备征战，当刘备为平原相时，他们俩为别部司马。二人与刘备寝则同床，恩若兄弟。稠人广坐则侍立终日。随同曹操和刘备讨吕布于下邳，事后为朝廷封为中郎将。当刘备袭杀曹操的徐州刺史车冑后，以关羽镇下邳太守..."@zh ;
    sg:novelDescription "因本处势豪倚势凌人，关羽杀之而逃难江湖。闻涿县招军破贼，特来应募。与刘备、张飞桃园结义，羽居其次。使八十二斤青龙偃月刀随刘备东征西讨。虎牢关温酒斩华雄，屯土山降汉不降曹。为报恩斩颜良、诛文丑，解曹操白马之围。后得知刘备音信，过五关斩六..."@zh ;
    sg:younger_sworn_brother sg:刘备 ;
    sg:elder_sworn_brother sg:张飞 ;
    sg:holds sg:五虎上将 ;
    sg:holds sg:五虎上将之首 ;
