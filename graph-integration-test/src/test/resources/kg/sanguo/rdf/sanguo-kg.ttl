sg:王象 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "王象"@zh ;
    sg:courtesyName "羲伯"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "少孤贫，为人牧羊而读书不辍。魏建立后，任象散骑侍郎，迁为常侍，封列侯。受诏撰《皇览》，使象领秘书监。象文采温雅，京师称为儒宗。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:司隶河内郡 .
sg:刘勋 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "刘勋"@zh ;
    sg:courtesyName "劉勳"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "任虎牙将军，后为冀州牧袁绍所害。"@zh ;
    sg:serves sg:东汉 ;
    sg:holds sg:虎牙将军 .
sg:华周 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "华周"@zh ;
    sg:courtesyName "華周"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "华歆少子。博学有才思，历官黄门侍郎、常山太守。中年遇疾，卒于家。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:青州平原郡高唐 .
sg:费恭 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "费恭"@zh ;
    sg:courtesyName "費恭"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "费祎之子。尚公主，为尚书郎，显名当世，早卒。"@zh ;
    sg:brother sg:费承 ;
    sg:serves sg:蜀 ;
    sg:nativePlace <http://pengcheng.com/phoenixgraph/kg/sanguo#荆州江夏郡[魏]鄳> .
sg:杜轸 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "杜轸"@zh ;
    sg:courtesyName "超宗"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "杜雄之子。师事学者谯周，博涉经书。州辟不就，任郡功曹史。入晋后，官至犍为太守。"@zh ;
    sg:serves sg:蜀 ;
    sg:nativePlace <http://pengcheng.com/phoenixgraph/kg/sanguo#益州蜀郡成都[蜀郡]> .
sg:张咸 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "张咸"@zh ;
    sg:courtesyName "張咸"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "凤凰元年（272），为江陵督。时晋将羊祜攻江陵，咸固守，祜不能拔。"@zh ;
    sg:serves sg:吴 .
sg:李绪 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "李绪"@zh ;
    sg:courtesyName "李緒"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "李通之子。建安中，曾屯樊城，有功。曹丕即位，诏拜平虏中郎将。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace <http://pengcheng.com/phoenixgraph/kg/sanguo#荆州江夏郡[魏]平春> .
sg:刘舆 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "刘舆"@zh ;
    sg:courtesyName "劉輿"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "曾任山阳（今山东金乡西）太守。"@zh ;
    sg:serves sg:东汉 ;
    sg:nativePlace sg:青州东莱郡牟平 .
sg:徐矫 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "徐矫"@zh ;
    sg:courtesyName "徐娇"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "孙权徐夫人兄。父徐琨死后，袭封为广德侯。后讨平山越，拜偏将军。死后无子，弟徐祚袭其封。"@zh ;
    sg:serves sg:吴 ;
    sg:nativePlace sg:扬州吴郡富春 .
sg:赵咨 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "赵咨"@zh ;
    sg:courtesyName "君初"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "董卓之乱，与同县司马朗奔黎阳。后仕魏为尚书。"@zh ;
    sg:father sg:赵酆 ;
    sg:serves sg:魏 ;
    sg:holds sg:尚书 ;
    sg:nativePlace sg:司隶河内郡温 .
sg:甄黄 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "甄黄"@zh ;
    sg:courtesyName "甄黄"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "魏文帝甄皇后母家从孙。早卒。明帝爱女曹淑死，追封平原懿公主，取甄黄柩与之合葬。追封黄列侯。"@zh ;
    sg:husband sg:曹淑 ;
    sg:serves sg:在野 ;
    sg:nativePlace sg:冀州中山国毋极 .
sg:刘略 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "刘略"@zh ;
    sg:courtesyName "劉略"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "吴零陵太守，卒于官。"@zh ;
    sg:serves sg:吴 ;
    sg:holds sg:零陵太守 ;
    sg:nativePlace sg:徐州广陵郡 .
sg:宗玮 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "宗玮"@zh ;
    sg:courtesyName "宗瑋"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "任太中大夫。刘备章武二年（222）冬，孙权闻备住白帝，甚懼，遣使请和。备许之，遣玮报命。"@zh ;
    sg:serves sg:蜀 ;
    sg:holds sg:太中大夫 .
sg:孟贲 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "孟贲"@zh ;
    sg:courtesyName "孟賁"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "宦官。顺帝时为中常侍，为顺帝所宠爱。永和年间，与曹腾一同遭张逵等人诬害，被缚问罪。帝诛逵等，释贲与腾。"@zh ;
    sg:serves sg:东汉 ;
    sg:nativePlace sg:司隶河南尹雒阳 .
sg:靳详 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "靳详"@zh ;
    sg:courtesyName "靳詳"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "诸葛亮围陈仓，使详游说魏将军郝昭，昭不为动。"@zh ;
    sg:novelDescription "演义中为靳祥，与郝昭自幼交契。于“讨魏国武侯再上表，破曹兵姜维诈献书”一章中奉诸葛亮之命两次劝说郝昭，都未能说服。"@zh ;
    sg:serves sg:蜀 ;
    sg:nativePlace sg:并州太原郡 ;
    sg:appearsIn sg:第97回 .
sg:张硕 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "张硕"@zh ;
    sg:courtesyName "張碩"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "黄祖部将。孙权征江夏，硕为权将凌统所斩。"@zh ;
    sg:serves sg:刘表势力 .
sg:甘宁 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "甘宁"@zh ;
    sg:courtesyName "兴霸"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "吴折冲将军、西陵太守。少有气力，好游侠。曾聚合一伙轻薄少年成群结队，携弓带箭，头插鸟羽，身佩铃铛。当时百姓一听铃响便知是甘宁到了。时人以“锦帆贼”呼之。后读诸子，率八百健儿依刘表，因居南阳，不见进用。欲投江东但为黄祖留于夏口。期间曾射..."@zh ;
    sg:novelDescription "吴将。初为锦帆贼，后投黄祖，未受重用，转仕吴，并助孙权败黄祖军。与曹军战，甘宁冲锋在先，奋勇杀敌，百骑劫曹营。后救凌统，两人遂结为生死之交。刘备伐吴时甘宁得痢疾，带病出战。后为蛮王沙摩柯以箭射头，坐于大树之下而死，树上群鸦数百，围绕其尸。"@zh ;
    sg:serves sg:刘表势力 ;
    sg:serves sg:刘焉 ;
    sg:serves sg:吴 ;
    sg:holds sg:折冲将军 ;
    sg:holds sg:西陵太守 ;
    sg:nativePlace sg:益州巴郡临江 ;
