sg:赵酆 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "赵酆"@zh ;
    sg:courtesyName "子"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "齐王芳时，曾预朝议。入晋，为骠骑将军，封东平陵公。"@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:司隶河内郡温 ;
    sg:son sg:赵咨 .
sg:吕雅 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "吕雅"@zh ;
    sg:courtesyName "吕雅"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "吕乂之子。任谒者。清厉有文才，著《格论》十五篇。蜀亡后，由罗宪荐于晋武帝，被叙用。"@zh ;
    sg:serves sg:蜀 ;
    sg:nativePlace sg:荆州南阳郡 .
sg:马平 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "马平"@zh ;
    sg:courtesyName "馬平"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "西晋博士。"@zh ;
    sg:serves sg:西晋 .
sg:卫京 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "卫京"@zh ;
    sg:courtesyName "衛京"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "卫臻之子，卫烈之弟。至二千石。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:兖州陈留郡襄邑 .
sg:张角 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "张角"@zh ;
    sg:courtesyName "張角"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "东汉末农民起义领袖。汉灵帝时期在各地传播“太平道”，发展部众至几十万，遍及青、徐、幽、冀、荆、扬、兗、豫八州。184年二月，张角发动起义，打出了“苍天已死，黄天当立”的口号，矛头直指东汉政府，史称“黄巾起义”，影响遍及全国，极大地动摇..."@zh ;
    sg:novelDescription "原是个不第的秀才，在山中采药时遇南华老仙，得天书三卷，名为《太平要术》。张角依此书所传道术，开始散施符水，为人治病，徒众发展到数十万。张角遂起了夺取天下得野心，与兄弟张宝、张梁一起起兵造反，声势浩大，但最终被朝廷和各路豪杰镇压。张角病..."@zh ;
    sg:serves sg:张角势力 ;
    sg:holds sg:天公将军 ;
    sg:nativePlace sg:冀州巨鹿郡 ;
    sg:appearsIn sg:第1回 ;
    sg:appearsIn sg:第2回 ;
    sg:appearsIn sg:第28回 ;
    sg:appearsIn sg:第29回 ;
    sg:elder_brother sg:张宝 .
sg:陈勋 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "陈勋"@zh ;
    sg:courtesyName "陳勳"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "赤乌八年（245）为校尉，将屯田及作士三万人凿句容中道。"@zh ;
    sg:serves sg:吴 .
sg:郭喜 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "郭喜"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "郭德子，喜纯粹有美好的德行，历任中书郎、右卫将军、侍中，官位做到辅国大将军，加授散骑常侍。与皇室是姻亲。"@zh ;
    sg:serves sg:魏 ;
    sg:holds sg:中书郎 ;
    sg:holds sg:右卫将军 ;
    sg:holds sg:侍中 ;
    sg:holds sg:辅国大将军 ;
    sg:holds sg:散骑常侍 ;
    sg:nativePlace sg:凉州西平郡 .
sg:吉邈 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "吉邈"@zh ;
    sg:courtesyName "文然"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "太医令吉本之子。建安二十三年（218），与父吉本、弟吉穆、少府耿纪、司直韦晃、金祎等千余人在许昌起事反曹操，败死。"@zh ;
    sg:novelDescription "太医令吉本之子。与弟吉穆、少府耿纪、司直韦晃、金祎等千余人在许昌起事反曹操，败死。"@zh ;
    sg:serves sg:东汉 ;
    sg:appearsIn sg:第69回 .
sg:阴夔 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "阴夔"@zh ;
    sg:courtesyName "陰夔"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "未合，尚惧，故豫州刺史阴夔及陈琳乞降，公不许，为围益急。"@zh ;
    sg:serves sg:袁绍势力 ;
    sg:nativePlace sg:司隶河内郡 .
sg:王徽 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "王徽"@zh ;
    sg:courtesyName "王徽"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "王基之子，早卒。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:青州东莱郡曲成 .
sg:田彭祖 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "田彭祖"@zh ;
    sg:courtesyName "田彭祖"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "田豫之子。豫死，彭祖嗣。"@zh ;
    sg:serves sg:魏 ;
    sg:nativePlace sg:幽州渔阳郡雍奴 .
sg:杨密 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "杨密"@zh ;
    sg:courtesyName "楊密"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "郭汜部将。是时，郭汜议欲攻李傕，杨彪进言反对，汜怒，欲手刃之，中郎将密及左右多谏，汜乃归之。"@zh ;
    sg:novelDescription "杨彪曰：“一劫天子，一劫公卿，意欲何为？”汜大怒，便拔剑欲杀彪。中郎将杨密力劝，汜乃放了杨彪、朱隽，其余都监在营中。"@zh ;
    sg:serves sg:董卓势力 ;
    sg:appearsIn sg:第13回 .
sg:杜锡 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "杜锡"@zh ;
    sg:courtesyName "世嘏"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "初为长沙王司马乂文学。后历太子中舍人、卫将军长史、治书御史等。官至尚书左丞。年四十八死，赠散骑常侍。"@zh ;
    sg:serves sg:西晋 ;
    sg:nativePlace sg:司隶京兆尹杜陵 .
sg:商汤 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "商汤"@zh ;
    sg:courtesyName "商湯"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "商朝的创建者（约前1617年—前1588年在位）儒家推崇的上古圣王之一，在位30年，其中17年为部落首领，13年为商朝君主。姓子，名履，今人多称商汤，甲骨文称啺（音“唐”，为甲骨文的“唐”字）、大乙、太乙，又称高祖乙，原商族部落首领，..."@zh ;
    sg:novelDescription "商朝时期人，演义中曾提到此人。"@zh ;
    sg:serves sg:其他 ;
    sg:nativePlace sg:豫州梁国砀 ;
    sg:appearsIn sg:第60回 ;
    sg:appearsIn sg:第91回 ;
    sg:appearsIn sg:第105回 ;
    sg:appearsIn sg:第112回 .
sg:徐晃 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> sg:Male ;
    <http://www.w3.org/2000/01/rdf-schema#label> "徐晃"@zh ;
    sg:courtesyName "公明"@zh ;
    sg:historicity "史实人物"@zh ;
    sg:historicalDescription "原为军阀杨奉的部下任骑都尉。曹操击败杨奉后投靠曹操。参加过多次重大作战，智勇双全，战功卓著，治军有方。曹操曾称赞徐晃：“徐将军可谓有周亚夫之风矣。”在曹操军中历任裨将军、偏将军、横野将军、平寇将军。官渡之战中烧毁袁绍的后勤粮草有功，加..."@zh ;
    sg:novelDescription "初从杨奉，善使大斧，武艺过人，曾助奉救驾，败郭汜。后太祖与杨奉相争，甚爱晃才，遂遣满宠说徐晃来降。晃随曹操南征北战，平吕布，灭袁绍，战马超，降张鲁，多有战功。关羽围樊城，徐晃奉命解围，先败关平，与曹仁里应外合，大败关羽。魏建，降将孟达..."@zh ;
    sg:serves sg:东汉 ;
    sg:serves sg:魏 ;
    sg:holds sg:右将军 ;
    sg:holds sg:假节 ;
    sg:holds sg:阳平侯 ;
    sg:nativePlace sg:司隶河东郡杨 ;
    sg:appearsIn sg:第13回 ;
    sg:appearsIn sg:第14回 ;
    sg:appearsIn sg:第19回 ;
    sg:appearsIn sg:第23回 ;
    sg:appearsIn sg:第24回 ;
    sg:appearsIn sg:第25回 ;
