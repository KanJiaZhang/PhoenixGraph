{
  "id": 52,
  "name": "tpc-h-data",
  "schemaVersion": 1,
  "description": "The TPC-H data instance: materialised lineitem fact rows (with denormalised dimensions) and the star-schema links, so the metrics of the semantic layer can be answered with real numbers.",
  "constraints": { "idSchemaIndex": 0, "createdTimeIndex": -2, "lastUpdatedTimeIndex": -1 },
  "vertexSchemas": [
    {
      "id": 1,
      "name": "Sale",
      "description": "A materialised order-line fact row (TPC-H lineitem), with its dimensions denormalised",
      "idSchema": { "id": 0, "name": "id", "description": "Sale id (lineitem key)", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "name", "description": "Sale id (display)", "type": "STRING", "display": true },
        { "id": 2, "name": "extendedprice", "description": "金额 = 单价 × 数量", "type": "DOUBLE" },
        { "id": 3, "name": "discount", "description": "折扣率 0..1", "type": "DOUBLE" },
        { "id": 4, "name": "tax", "description": "税率 0..1", "type": "DOUBLE" },
        { "id": 5, "name": "quantity", "description": "数量", "type": "DOUBLE" },
        { "id": 6, "name": "revenue", "description": "净收入 = extendedprice × (1 - discount)", "type": "DOUBLE" },
        { "id": 7, "name": "gross", "description": "毛收入 = extendedprice", "type": "DOUBLE" },
        { "id": 8, "name": "discountAmount", "description": "折扣额 = extendedprice × discount", "type": "DOUBLE" },
        { "id": 9, "name": "taxAmount", "description": "税额 = extendedprice × (1 - discount) × tax", "type": "DOUBLE" },
        { "id": 10, "name": "lateDelivery", "description": "迟到标记（收货日 > 承诺日 = 1）", "type": "LONG" },
        { "id": 11, "name": "returned", "description": "退货标记（returnflag = R = 1）", "type": "LONG" },
        { "id": 12, "name": "region", "description": "地区（客户所在大区）", "type": "STRING" },
        { "id": 13, "name": "nation", "description": "国家", "type": "STRING" },
        { "id": 14, "name": "segment", "description": "市场细分", "type": "STRING" },
        { "id": 15, "name": "priority", "description": "订单优先级", "type": "STRING" },
        { "id": 16, "name": "shipmode", "description": "运输方式", "type": "STRING" },
        { "id": 17, "name": "partType", "description": "商品类型（PROMO 前缀 = 促销品）", "type": "STRING" },
        { "id": 18, "name": "brand", "description": "品牌", "type": "STRING" },
        { "id": 19, "name": "supplierName", "description": "供应商名", "type": "STRING" },
        { "id": 20, "name": "orderYear", "description": "下单年", "type": "LONG" },
        { "id": 21, "name": "orderMonth", "description": "下单月 1..12", "type": "LONG" }
      ]
    },
    {
      "id": 2,
      "name": "Part",
      "description": "商品",
      "idSchema": { "id": 0, "name": "id", "description": "Part id", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "name", "description": "商品 name", "type": "STRING", "display": true },
        { "id": 2, "name": "partType", "description": "类型", "type": "STRING" }
      ]
    },
    {
      "id": 3,
      "name": "Supplier",
      "description": "供应商",
      "idSchema": { "id": 0, "name": "id", "description": "Supplier id", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "name", "description": "供应商 name", "type": "STRING", "display": true },
        { "id": 2, "name": "nation", "description": "所在国家", "type": "STRING" }
      ]
    },
    {
      "id": 4,
      "name": "Customer",
      "description": "客户",
      "idSchema": { "id": 0, "name": "id", "description": "Customer id", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "name", "description": "客户 name", "type": "STRING", "display": true },
        { "id": 2, "name": "segment", "description": "市场细分", "type": "STRING" }
      ]
    },
    {
      "id": 5,
      "name": "Nation",
      "description": "国家",
      "idSchema": { "id": 0, "name": "id", "description": "Nation id", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "name", "description": "国家 name", "type": "STRING", "display": true },
        { "id": 2, "name": "region", "description": "所在大区", "type": "STRING" }
      ]
    },
    {
      "id": 6,
      "name": "Region",
      "description": "地区",
      "idSchema": { "id": 0, "name": "id", "description": "Region id", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "name", "description": "地区 name", "type": "STRING", "display": true }
      ]
    },
    {
      "id": 7,
      "name": "Order",
      "description": "订单",
      "idSchema": { "id": 0, "name": "id", "description": "Order id", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "name", "description": "订单 name", "type": "STRING", "display": true },
        { "id": 2, "name": "priority", "description": "优先级", "type": "STRING" }
      ]
    }
  ],
  "edgeSchemas": [
    {
      "id": 1,
      "name": "ofPart",
      "description": "含商品：Sale → Part",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id", "type": "STRING" },
      "source": { "id": 1, "name": "source", "description": "Source vertex id", "type": "STRING", "vertex": "Sale" },
      "target": { "id": 2, "name": "target", "description": "Target vertex id", "type": "STRING", "vertex": "Part" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "direction": "DIRECTED",
      "properties": [
        { "id": 3, "name": "relationLabel", "description": "中文关系名", "type": "STRING" }
      ]
    },
    {
      "id": 2,
      "name": "ofSupplier",
      "description": "由供应商供：Sale → Supplier",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id", "type": "STRING" },
      "source": { "id": 1, "name": "source", "description": "Source vertex id", "type": "STRING", "vertex": "Sale" },
      "target": { "id": 2, "name": "target", "description": "Target vertex id", "type": "STRING", "vertex": "Supplier" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "direction": "DIRECTED",
      "properties": [
        { "id": 3, "name": "relationLabel", "description": "中文关系名", "type": "STRING" }
