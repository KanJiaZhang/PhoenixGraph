    },
    {
      "id": 7,
      "name": "nationRegion",
      "description": "所在大区：Nation → Region",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id", "type": "STRING" },
      "source": { "id": 1, "name": "source", "description": "Source vertex id", "type": "STRING", "vertex": "Nation" },
      "target": { "id": 2, "name": "target", "description": "Target vertex id", "type": "STRING", "vertex": "Region" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "direction": "DIRECTED",
      "properties": [
        { "id": 3, "name": "relationLabel", "description": "中文关系名", "type": "STRING" }
      ]
    }
  ],
  "storage": { "type": "RocksDB-Edge", "path": "tpc-h-data", "regionCount": 64, "maxVersions": 1, "cacheEdges": true }
}
