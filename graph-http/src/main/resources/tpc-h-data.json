    },
    {
      "id": 3,
      "name": "ofOrder",
      "description": "属于订单：Sale → Order",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id", "type": "STRING" },
      "source": { "id": 1, "name": "source", "description": "Source vertex id", "type": "STRING", "vertex": "Sale" },
      "target": { "id": 2, "name": "target", "description": "Target vertex id", "type": "STRING", "vertex": "Order" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
      "direction": "DIRECTED",
      "properties": [
        { "id": 3, "name": "relationLabel", "description": "中文关系名", "type": "STRING" }
      ]
    },
    {
      "id": 4,
      "name": "placedBy",
      "description": "下单客户：Order → Customer",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id", "type": "STRING" },
      "source": { "id": 1, "name": "source", "description": "Source vertex id", "type": "STRING", "vertex": "Order" },
      "target": { "id": 2, "name": "target", "description": "Target vertex id", "type": "STRING", "vertex": "Customer" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation timestamp", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update timestamp", "type": "LONG" },
