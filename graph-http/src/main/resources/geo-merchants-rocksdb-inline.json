{
  "id": 21,
  "name": "geo-merchants-rocksdb-inline",
  "description": "Shops with a geo index, served by RocksDB-Inline (the S2 cell id of every shop is indexed in a table of its own)",
  "constraints": {
    "idSchemaIndex": 0,
    "createdTimeIndex": -2,
    "lastUpdatedTimeIndex": -1
  },
  "storage": {
    "type": "RocksDB-Inline",
    "path": "geo-merchants-rocksdb-inline",
    "regionCount": 512,
    "maxVersions": 1,
    "cacheEdges": true
  },
  "vertexSchemas": [
    {
      "id": 1,
      "name": "Merchant",
      "description": "A shop with a geographic location",
      "idSchema": {
        "id": 0,
        "name": "id",
        "description": "Merchant id",
        "type": "LONG"
      },
      "createdTime": {
        "id": -2,
        "name": "createdTime",
        "description": "Creation time",
        "type": "LONG"
      },
      "lastUpdatedTime": {
        "id": -1,
        "name": "lastUpdatedTime",
        "description": "Last update time",
        "type": "LONG"
      },
      "properties": [
        {
          "id": 1,
          "name": "name",
          "description": "Shop name",
          "type": "STRING",
          "display": true
        },
        {
          "id": 2,
          "name": "category",
          "description": "Shop category",
          "type": "STRING",
          "display": true
        },
        {
          "id": 3,
          "name": "rating",
          "description": "Average rating",
          "type": "DOUBLE"
        },
        {
          "id": 4,
          "name": "address",
          "description": "Street address",
          "type": "STRING"
        },
        {
          "id": 5,
          "name": "location",
          "description": "Where the shop is, as {lat, lon}; indexed with Google S2 cells",
          "type": {
            "map": "DOUBLE"
          },
          "isGeo": true
        },
        {
          "id": 6,
          "name": "openNow",
          "description": "Whether the shop is open",
          "type": "BOOLEAN"
        }
      ]
    }
  ],
  "edgeSchemas": [
    {
      "id": 1,
      "name": "Opens",
      "description": "A deal a merchant announced before the counterpart is known (nullable target)",
      "idSchema": {
        "id": 0,
        "name": "id",
        "description": "Deal id",
        "type": "STRING"
      },
      "source": {
        "id": 1,
        "name": "source",
        "description": "The merchant announcing it",
        "type": "LONG",
        "vertex": "Merchant"
      },
      "target": {
        "id": 2,
        "name": "target",
        "description": "The counterpart, still unknown",
        "type": "LONG",
        "vertex": "Merchant",
        "isNull": true
      },
      "createdTime": {
        "id": -2,
        "name": "createdTime",
        "description": "Creation time",
        "type": "LONG"
      },
      "lastUpdatedTime": {
        "id": -1,
        "name": "lastUpdatedTime",
        "description": "Last update time",
        "type": "LONG"
      },
      "direction": "DIRECTED",
      "maxOutgoingEdges": 10,
      "maxIncomingEdges": 0,
      "maxDegree": 0,
      "properties": [
        {
          "id": 3,
          "name": "since",
          "description": "Announced at (epoch millis)",
          "type": "LONG"
        },
        {
          "id": 4,
          "name": "title",
          "description": "What the deal is",
          "type": "STRING",
          "display": true
        }
      ]
    }
  ]
}
