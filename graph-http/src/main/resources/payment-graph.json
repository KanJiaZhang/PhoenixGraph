{
  "id": 1,
  "name": "payment-graph",
  "description": "Account / IP / Phone graph schema",
  "constraints": {
    "idSchemaIndex": 0,
    "createdTimeIndex": -2,
    "lastUpdatedTimeIndex": -1
  },
  "vertexSchemas": [
    {
      "id": 1,
      "name": "Account",
      "description": "An account",
      "idSchema": { "id": 0, "name": "id", "description": "Account id", "type": "LONG" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "accountStatus", "description": "Account status", "type": { "enum": ["ACTIVE", "FROZEN", "CLOSED"] } },
        { "id": 2, "name": "accountType", "description": "Account type", "type": "STRING" },
        { "id": 3, "name": "primaryAddress", "description": "Primary address", "type": "STRING" },
        { "id": 4, "name": "accountUsage", "description": "Account usage types", "type": { "list": "STRING" } },
        { "id": 5, "name": "accountLimited", "description": "Account limits / flags", "type": { "map": "STRING" } },
        { "id": 6, "name": "firstName", "description": "Account holder first name", "type": "STRING", "display": true },
        { "id": 7, "name": "lastName", "description": "Account holder last name", "type": "STRING", "display": true },
        { "id": 8, "name": "username", "description": "Login name, e.g. zhang1988", "type": "STRING", "display": true },
        { "id": 9, "name": "email", "description": "Email address", "type": "STRING" },
        { "id": 10, "name": "phoneNumber", "description": "Phone number in E.164 form, e.g. +8613800138000", "type": "STRING" },
        { "id": 11, "name": "cardNumber", "description": "Card number; its first digits are the BIN", "type": "STRING" },
        { "id": 12, "name": "ipAddress", "description": "The address the account was last seen from", "type": "STRING" }
      ]
    },
    {
      "id": 2,
      "name": "IP",
      "description": "An IP address",
      "idSchema": { "id": 0, "name": "id", "description": "IP id (the address itself)", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "ipAddress", "description": "IP address string", "type": "STRING", "display": true }
      ]
    },
    {
      "id": 3,
      "name": "Phone",
      "description": "A phone number",
      "idSchema": { "id": 0, "name": "id", "description": "Phone id (the number itself)", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "cnCode", "description": "Country calling code, e.g. +86", "type": "STRING", "display": true },
        { "id": 2, "name": "phoneNumber", "description": "Phone number", "type": "STRING", "minLength": 3, "maxLength": 20, "display": true }
      ]
    },
    {
      "id": 4,
      "name": "FuzzyPattern",
      "description": "A fuzzy linking pattern: what a context is reduced to before it becomes a key",
      "idSchema": { "id": 0, "name": "id", "description": "Pattern vertex id, pattern_<id>", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "patternId", "description": "Pattern number", "type": "INT" },
        { "id": 2, "name": "expression", "description": "The expression the pattern is", "type": "STRING", "display": true },
        { "id": 3, "name": "name", "description": "Human readable name", "type": "STRING", "display": true },
        { "id": 4, "name": "description", "description": "What the pattern looks for", "type": "STRING" },
        { "id": 5, "name": "enabled", "description": "Whether queries use it", "type": "BOOLEAN" }
      ]
    },
    {
      "id": 5,
      "name": "FuzzyLink",
      "description": "A link node: every account whose context produces the same key points here",
      "idSchema": { "id": 0, "name": "id", "description": "Link vertex id, fl_<pattern>_<key>", "type": "STRING" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "properties": [
        { "id": 1, "name": "patternId", "description": "The pattern that produced the key", "type": "INT" },
        { "id": 2, "name": "key", "description": "The link key: the fragments joined", "type": "STRING", "display": true },
        { "id": 3, "name": "pattern", "description": "The expression that produced it", "type": "STRING", "display": true }
      ]
    }
  ],
  "edgeSchemas": [
    {
      "id": 1,
      "name": "Payment",
      "description": "A payment from a sender to a receiver",
      "idSchema": { "id": 0, "name": "id", "description": "Payment id", "type": "LONG" },
      "source": { "id": 1, "name": "source", "description": "Sender vertex id", "type": "LONG", "vertex": "Account" },
      "target": { "id": 2, "name": "target", "description": "Receiver vertex id", "type": "LONG", "vertex": "Account" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "direction": "DIRECTED",
      "maxOutgoingEdges": 1000,
      "maxIncomingEdges": 1000,
      "properties": [
        { "id": 3, "name": "status", "description": "Payment status", "type": { "enum": ["PENDING", "SUCCESS", "FAILED"] } },
        { "id": 4, "name": "type", "description": "Payment type", "type": "STRING" },
        { "id": 5, "name": "amount", "description": "Payment amount", "type": "DOUBLE", "min": 0.0, "max": 1000000000.0 },
        { "id": 6, "name": "currency", "description": "Currency code", "type": "STRING" }
      ]
    },
    {
      "id": 2,
      "name": "PhoneToAccount",
      "description": "A phone belongs to an account",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id", "type": "LONG" },
      "source": { "id": 1, "name": "source", "description": "Phone vertex id (the value)", "type": "STRING", "vertex": "Phone" },
      "target": { "id": 2, "name": "target", "description": "Account vertex id", "type": "LONG", "vertex": "Account" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "direction": "DIRECTED",
      "maxOutgoingEdges": 10,
      "maxIncomingEdges": 1000,
      "properties": [
        { "id": 3, "name": "linkedAt", "description": "Time when the phone was linked to the account", "type": "LONG" }
      ]
    },
    {
      "id": 3,
      "name": "AccountToPhone",
      "description": "An account owns a phone",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id", "type": "LONG" },
      "source": { "id": 1, "name": "source", "description": "Account vertex id", "type": "LONG", "vertex": "Account" },
      "target": { "id": 2, "name": "target", "description": "Phone vertex id (the value)", "type": "STRING", "vertex": "Phone" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "direction": "DIRECTED",
      "maxOutgoingEdges": 10,
      "maxIncomingEdges": 1000,
      "properties": [
        { "id": 3, "name": "linkedAt", "description": "Time when the phone was linked", "type": "LONG" }
      ]
    },
    {
      "id": 4,
      "name": "AccountToIP",
      "description": "An account logs in from an IP",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id", "type": "LONG" },
      "source": { "id": 1, "name": "source", "description": "Account vertex id", "type": "LONG", "vertex": "Account" },
      "target": { "id": 2, "name": "target", "description": "IP vertex id (the value)", "type": "STRING", "vertex": "IP" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "direction": "DIRECTED",
      "maxOutgoingEdges": 100,
      "maxIncomingEdges": 1000,
      "properties": [
        { "id": 3, "name": "loginTime", "description": "Login time", "type": "LONG" }
      ]
    },
    {
      "id": 5,
      "name": "IPToAccount",
      "description": "An IP is linked to an account",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id", "type": "LONG" },
      "source": { "id": 1, "name": "source", "description": "IP vertex id (the value)", "type": "STRING", "vertex": "IP" },
      "target": { "id": 2, "name": "target", "description": "Account vertex id", "type": "LONG", "vertex": "Account" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "direction": "DIRECTED",
      "maxOutgoingEdges": 100,
      "maxIncomingEdges": 1000,
      "properties": [
        { "id": 3, "name": "linkedAt", "description": "Link time", "type": "LONG" }
      ]
    },
    {
      "id": 6,
      "name": "FuzzyLinkedTo",
      "description": "An account belongs to a fuzzy link node",
      "idSchema": { "id": 0, "name": "id", "description": "Edge id, <link>|<account>", "type": "STRING" },
      "source": { "id": 1, "name": "source", "description": "Link vertex id", "type": "STRING", "vertex": "FuzzyLink" },
      "target": { "id": 2, "name": "target", "description": "Account vertex id", "type": "LONG", "vertex": "Account" },
      "createdTime": { "id": -2, "name": "createdTime", "description": "Creation time", "type": "LONG" },
      "lastUpdatedTime": { "id": -1, "name": "lastUpdatedTime", "description": "Last update time", "type": "LONG" },
      "direction": "DIRECTED",
      "maxOutgoingEdges": 1000,
      "maxIncomingEdges": 1000,
      "properties": [
        { "id": 3, "name": "patternId", "description": "The pattern that produced the link", "type": "INT" },
        { "id": 4, "name": "key", "description": "The link key", "type": "STRING" }
      ]
    }
  ]
}
