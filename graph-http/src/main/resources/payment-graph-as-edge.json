        "type": "LONG"
      },
      "source": {
        "id": 1,
        "name": "source",
        "description": "Phone vertex id (the value)",
        "type": "STRING",
        "vertex": "Phone"
      },
      "target": {
        "id": 2,
        "name": "target",
        "description": "Account vertex id",
        "type": "LONG",
        "vertex": "Account"
