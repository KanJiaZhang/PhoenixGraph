{
  "id": 31,
  "name": "payment-graph-as-edge",
  "description": "Account / IP / Phone graph served by Aerospike-Edge: the big vertices keep their edges in the aggregated Edge_Out / Edge_In tables (chunked by creation time and indexed by two more levels), written by a bulk import; a query reads them by time window",
  "constraints": {
    "idSchemaIndex": 0,
    "createdTimeIndex": -2,
    "lastUpdatedTimeIndex": -1
  },
  "vertexSchemas": [
    {
      "id": 1,
      "name": "Account",
      "description": "An account",
      "idSchema": {
        "id": 0,
        "name": "id",
        "description": "Account id",
        "type": "LONG"
      },
      "createdTime": {
        "id": -2,
        "name": "createdTime",
        "description": "Creation time",
        "type": "LONG"
      },
      "lastUpdatedTime": {
        "id": -1,
        "name": "lastUpdatedTime",
        "description": "Last update time",
        "type": "LONG"
      },
      "properties": [
        {
          "id": 1,
          "name": "accountStatus",
          "description": "Account status",
          "type": {
            "enum": [
              "ACTIVE",
              "FROZEN",
              "CLOSED"
            ]
          }
        },
        {
          "id": 2,
          "name": "accountType",
          "description": "Account type",
          "type": "STRING"
        },
        {
          "id": 3,
          "name": "primaryAddress",
          "description": "Primary address",
          "type": "STRING"
        },
        {
          "id": 4,
          "name": "accountUsage",
          "description": "Account usage types",
          "type": {
            "list": "STRING"
          }
        },
        {
          "id": 5,
          "name": "accountLimited",
          "description": "Account limits / flags",
          "type": {
            "map": "STRING"
          }
        },
        {
          "id": 6,
          "name": "firstName",
          "description": "Account holder first name",
          "type": "STRING",
          "display": true
        },
        {
          "id": 7,
          "name": "lastName",
          "description": "Account holder last name",
          "type": "STRING",
          "display": true
        }
      ]
    },
    {
      "id": 2,
      "name": "IP",
      "description": "An IP address",
      "idSchema": {
        "id": 0,
        "name": "id",
        "description": "IP id (the address itself)",
        "type": "STRING"
      },
      "createdTime": {
        "id": -2,
        "name": "createdTime",
        "description": "Creation time",
        "type": "LONG"
      },
      "lastUpdatedTime": {
        "id": -1,
        "name": "lastUpdatedTime",
        "description": "Last update time",
        "type": "LONG"
      },
      "properties": [
        {
          "id": 1,
          "name": "ipAddress",
          "description": "IP address string",
          "type": "STRING",
          "display": true
        }
      ]
    },
    {
      "id": 3,
      "name": "Phone",
      "description": "A phone number",
      "idSchema": {
        "id": 0,
        "name": "id",
        "description": "Phone id (the number itself)",
        "type": "STRING"
      },
      "createdTime": {
        "id": -2,
        "name": "createdTime",
        "description": "Creation time",
        "type": "LONG"
      },
      "lastUpdatedTime": {
        "id": -1,
        "name": "lastUpdatedTime",
        "description": "Last update time",
        "type": "LONG"
      },
      "properties": [
        {
          "id": 1,
          "name": "cnCode",
          "description": "Country calling code, e.g. +86",
          "type": "STRING",
          "display": true
        },
        {
          "id": 2,
          "name": "phoneNumber",
          "description": "Phone number",
          "type": "STRING",
          "minLength": 3,
          "maxLength": 20,
          "display": true
        }
      ]
    }
  ],
  "edgeSchemas": [
    {
      "id": 1,
      "name": "Payment",
