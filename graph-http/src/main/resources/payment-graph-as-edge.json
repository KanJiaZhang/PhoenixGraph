      "createdTime": {
        "id": -2,
        "name": "createdTime",
        "description": "Creation time",
        "type": "LONG"
      },
      "lastUpdatedTime": {
        "id": -1,
        "name": "lastUpdatedTime",
        "description": "Last update time",
        "type": "LONG"
      },
      "direction": "DIRECTED",
      "maxOutgoingEdges": 10,
      "maxIncomingEdges": 1000,
      "properties": [
