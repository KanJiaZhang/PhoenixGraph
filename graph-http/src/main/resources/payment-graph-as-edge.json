      "idSchema": {
        "id": 0,
        "name": "id",
        "description": "Payment id",
        "type": "LONG"
      },
      "source": {
        "id": 1,
        "name": "source",
        "description": "Sender vertex id",
        "type": "LONG",
        "vertex": "Account"
      },
      "target": {
        "id": 2,
        "name": "target",
        "description": "Receiver vertex id",
        "type": "LONG",
        "vertex": "Account"
      },
      "createdTime": {
        "id": -2,
