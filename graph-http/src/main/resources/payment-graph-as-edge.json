          "type": {
            "enum": [
              "PENDING",
              "SUCCESS",
              "FAILED"
            ]
          }
        },
        {
          "id": 4,
          "name": "type",
          "description": "Payment type",
          "type": "STRING"
        },
        {
          "id": 5,
          "name": "amount",
          "description": "Payment amount",
          "type": "DOUBLE",
          "min": 0,
          "max": 1000000000
        },
        {
          "id": 6,
          "name": "currency",
          "description": "Currency code",
          "type": "STRING"
        }
      ]
    },
    {
      "id": 2,
      "name": "PhoneToAccount",
