# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven
target/
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# IDE
.idea/

# Downloaded demo datasets (tools/download-siftsmall-dataset.sh)
.datasets/

# RocksDB graph directories (created by the service / the RocksDB loader)
.rocksdb/

# service logs and scratch files written while running it
.logs/

# exported session transcripts (regenerate with tools/session-export.mjs)
.sessions/

# a schema file the codec round-trip tests write into the working directory
/Test-Graph.json

# a schema built on this machine (the modelling page writes <graph>.json here)
/TestGraph.json

# internal working notes and daily logs (kept on the machine that writes them, not in the repo)
/CONTEXT.md
/DAILY-*.md
/HANDOVER.md
/TRAVERSER-DESIGN.md

# the agent toolkit's index artifact: regenerable from the documents (POST /api/v1/agent/ingest)
*.agent.json

# release artifacts: built by tools/release-1.0.sh, never committed (a tag names the source, the build makes the bytes)
dist/

# the three-minute demo writes its schema into the working directory
/demo-three-minute*.json

# Python (the client and its tests)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# demo graphs created by tools/ingest-docs.mjs
/incident-demo*.json
/http-embed-demo*.json
/incident-*.json
# the case-study graphs (docs/END-TO-END.md / docs/AGENT-INGESTION-CASE.md) write on ingestion
/case-*.json

# the secure overlay mounts this file; copy it from security.example.yml and never commit it
/deploy/secure/security.yml

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# local demo schemas written by earlier demo scripts
/demo-semantics.json
/demo-analytics.json

# JavaScript/TypeScript dependencies
node_modules/
